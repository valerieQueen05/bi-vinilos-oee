createOrReplace

	expression ServidorPostgres = "172.16.213.1:5432" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression BaseDatos = "bi_vinilos" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	table dim_fecha
		dataCategory: Time

		column sk_fecha
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: sk_fecha

		column fecha
			dataType: dateTime
			isKey
			formatString: dd/mm/yyyy
			summarizeBy: none
			sourceColumn: fecha

		column anio
			dataType: int64
			summarizeBy: none
			sourceColumn: anio

		column semestre
			dataType: int64
			summarizeBy: none
			sourceColumn: semestre

		column trimestre
			dataType: int64
			summarizeBy: none
			sourceColumn: trimestre

		column mes_num
			dataType: int64
			summarizeBy: none
			sourceColumn: mes_num

		column mes_nombre
			dataType: string
			summarizeBy: none
			sortByColumn: mes_num
			sourceColumn: mes_nombre

		column mes_abrev
			dataType: string
			summarizeBy: none
			sourceColumn: mes_abrev

		column anio_mes
			dataType: string
			summarizeBy: none
			sourceColumn: anio_mes

		column dia_mes
			dataType: int64
			summarizeBy: none
			sourceColumn: dia_mes

		column dia_semana_num
			dataType: int64
			summarizeBy: none
			sourceColumn: dia_semana_num

		column dia_semana_nombre
			dataType: string
			summarizeBy: none
			sortByColumn: dia_semana_num
			sourceColumn: dia_semana_nombre

		column semana_iso
			dataType: int64
			summarizeBy: none
			sourceColumn: semana_iso

		column anio_iso
			dataType: int64
			summarizeBy: none
			sourceColumn: anio_iso

		column es_fin_de_semana
			dataType: boolean
			summarizeBy: none
			sourceColumn: es_fin_de_semana

		column es_festivo
			dataType: boolean
			summarizeBy: none
			sourceColumn: es_festivo

		column nombre_festivo
			dataType: string
			summarizeBy: none
			sourceColumn: nombre_festivo

		column es_dia_habil
			dataType: boolean
			summarizeBy: none
			sourceColumn: es_dia_habil

		hierarchy 'Calendario'
			level 'Año'
				ordinal: 0
				column: anio
			level 'Trimestre'
				ordinal: 1
				column: trimestre
			level 'Mes'
				ordinal: 2
				column: mes_nombre
			level 'Día'
				ordinal: 3
				column: fecha

		partition dim_fecha = m
			mode: import
			source =
					let
					    Origen = PostgreSQL.Database(ServidorPostgres, BaseDatos),
					    Tabla = Origen{[Schema="dw",Item="dim_fecha"]}[Data]
					in
					    Tabla

