      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, SUM(pacas_producidas) AS \"Pacas reales\",\n       SUM(pacas_hora_ideal * minutos_planificados / 60) AS \"Pacas a velocidad ideal\"\nFROM dw.v_rt_hora\nWHERE $__timeFilter(ts) AND maquina IN (${maquina:sqlstring}) AND turno IN (${turno:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }
      ],
