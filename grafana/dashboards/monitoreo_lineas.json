    {
      "id": 8,
      "type": "timeseries",
      "title": "Pacas producidas vs. ideal por hora",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-bi"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
