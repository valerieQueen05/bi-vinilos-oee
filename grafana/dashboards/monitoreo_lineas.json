          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, maquina AS metric, oee AS value\nFROM dw.v_rt_hora\nWHERE $__timeFilter(ts) AND maquina IN (${maquina:sqlstring}) AND turno IN (${turno:sqlstring})\nORDER BY 1"
        }
