      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ts AS time,\n       AVG(disponibilidad) AS \"Disponibilidad\",\n       AVG(rendimiento) AS \"Rendimiento\",\n       AVG(calidad) AS \"Calidad\"\nFROM dw.v_rt_hora\nWHERE $__timeFilter(ts) AND maquina IN (${maquina:sqlstring}) AND turno IN (${turno:sqlstring})\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.2,
          "decimals": 1,
          "custom": {
