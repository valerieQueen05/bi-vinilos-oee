          "rawSql": "SELECT causa_principal AS causa, SUM(minutos_paro_disponibilidad) AS minutos\nFROM dw.v_rt_hora\nWHERE $__timeFilter(ts) AND maquina IN (${maquina:sqlstring}) AND turno IN (${turno:sqlstring}) AND minutos_paro_disponibilidad > 0\nGROUP BY 1 ORDER BY 2 DESC LIMIT 8"
