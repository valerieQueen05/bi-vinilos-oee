    {
      "id": 7,
      "type": "timeseries",
      "title": "Disponibilidad y rendimiento (promedio de máquinas seleccionadas)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-bi"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
