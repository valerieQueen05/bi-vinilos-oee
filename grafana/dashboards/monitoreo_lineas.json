    {
      "id": 6,
      "type": "table",
      "title": "Estado actual por máquina (última lectura)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-bi"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT maquina, turno, referencia, ts AS \"última lectura\",\n       oee, disponibilidad, rendimiento, calidad,\n       pacas_producidas AS pacas, minutos_paro_disponibilidad AS \"min paro\", causa_principal AS \"causa principal\"\nFROM dw.v_rt_estado_actual\nWHERE maquina IN (${maquina:sqlstring})\nORDER BY maquina"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
