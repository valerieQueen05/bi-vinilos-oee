# Copiar a .env y cambiar TODAS las passwords:   cp .env.example .env
# .env está en .gitignore: nunca se sube al repositorio.

# --- PostgreSQL (dueño de la base: lo usa solo el ETL) ---
POSTGRES_DB=bi_vinilos
POSTGRES_USER=etl_admin
POSTGRES_PASSWORD=cambia_esta_clave_admin

# --- Roles de mínimo privilegio ---
BI_LECTOR_PASSWORD=cambia_esta_clave_powerbi
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=cambia_esta_clave_grafana
SIM_DB_PASSWORD=cambia_esta_clave_simulador

# --- Grafana (usuario administrador de la interfaz web) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambia_esta_clave_grafana_web

# --- Puertos en el equipo anfitrión ---
DB_PUERTO_HOST=5432
GRAFANA_PUERTO_HOST=3000

# --- Simulador: 1 tick = 1 hora de producción ---
TICK_SEGUNDOS=30
BACKFILL_HORAS=40
